Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AragonTrigToExp", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Sin", "[", "x", "]"}], " ", 
     RowBox[{
      TemplateBox[{"1"},
       "C"], "[", "y", "]"}]}], "+", 
    RowBox[{
     RowBox[{"Cos", "[", "x", "]"}], " ", 
     RowBox[{
      TemplateBox[{"2"},
       "C"], "[", "y", "]"}]}]}], ",", "1", ",", "2", ",", "u"}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.9555411599244804`*^9, 3.955541167443865*^9}, {
   3.9555413533964233`*^9, 3.955541357906088*^9}, 3.955541460840906*^9},
 CellLabel->"In[4]:=",
 CellID->62681812,ExpressionUUID->"eedae284-3103-d942-a2bb-2e11f6c2aef1"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   FractionBox["1", "2"], " ", 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"\[ImaginaryI]", " ", "x"}]], " ", 
   RowBox[{"Conjugate", "[", 
    RowBox[{"u", "[", "y", "]"}], "]"}]}], "+", 
  RowBox[{
   FractionBox["1", "2"], " ", 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"-", "\[ImaginaryI]"}], " ", "x"}]], " ", 
   RowBox[{"u", "[", "y", "]"}]}]}]], "Output",
 CellChangeTimes->{{3.955541394975214*^9, 3.95554146656353*^9}},
 CellLabel->"Out[4]=",
 CellID->481371986,ExpressionUUID->"21b0f207-9ce7-224e-8589-f7ea1603a167"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AragonTrigToExp", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Sin", "[", 
      RowBox[{"k", " ", "x"}], "]"}], " ", 
     RowBox[{
      TemplateBox[{"1"},
       "C"], "[", 
      RowBox[{"n", " ", "y"}], "]"}]}], "+", 
    RowBox[{
     RowBox[{"Cos", "[", 
      RowBox[{"k", " ", "x"}], "]"}], " ", 
     RowBox[{
      TemplateBox[{"2"},
       "C"], "[", 
      RowBox[{"n", " ", "y"}], "]"}]}]}], ",", "1", ",", "2", ",", "s"}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.955541488761135*^9, 3.9555415621218605`*^9}},
 CellLabel->"In[6]:=",
 CellID->241220613,ExpressionUUID->"36039f24-fc44-c241-98d5-18e2c7bb2a86"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   FractionBox["1", "2"], " ", 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"\[ImaginaryI]", " ", "k", " ", "x"}]], " ", 
   RowBox[{"Conjugate", "[", 
    RowBox[{"s", "[", 
     RowBox[{"n", " ", "y"}], "]"}], "]"}]}], "+", 
  RowBox[{
   FractionBox["1", "2"], " ", 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"-", "\[ImaginaryI]"}], " ", "k", " ", "x"}]], " ", 
   RowBox[{"s", "[", 
    RowBox[{"n", " ", "y"}], "]"}]}]}]], "Output",
 CellChangeTimes->{3.9555415509953213`*^9, 3.9555415826192856`*^9},
