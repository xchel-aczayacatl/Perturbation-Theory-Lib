Notebook[{

Cell[CellGroupData[{
Cell["AragonTrigToExp", "ObjectName",
 CellID->106633547,ExpressionUUID->"3f120686-ea80-7d4f-9634-5c10299d69f0"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"9f0333a1-3249-334a-b32b-5dc200951c04"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["AragonTrigToExp",
    BaseStyle->"Link",
    ButtonData->"paclet:PerturbationTheory/ref/AragonTrigToExp"], "[", 
   RowBox[{
    StyleBox["expr", "TI"], ",", 
    StyleBox["subscr1", "TI"], ",", 
    StyleBox["subscr2", "TI"], ",", 
    StyleBox["var", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "5346c223-cd88-064d-9dc2-b8f32a247a3a"],
 " \[LineSeparator]transforms all the constants with subscripts ",
 Cell[BoxData[
  StyleBox["subscr1", "TI"]], "InlineFormula",ExpressionUUID->
  "8fbf9c90-c2f1-d146-88be-46c2ce2b670b"],
 " and ",
 Cell[BoxData[
  StyleBox["subscr2", "TI"]], "InlineFormula",ExpressionUUID->
  "3ccc7898-6933-4243-881f-81b3123f8b17"],
 " and all the ocurrences trigonometric functions Sin[x] and Cos[x] in the \
expression ",
 Cell[BoxData[
  StyleBox["expr", "TI"]], "InlineFormula",ExpressionUUID->
  "adf85789-16ce-e148-87ce-0c3f72ac8080"],
 ", to complex exponentials in the form suggested by Dr. Arag\[OAcute]n."
}], "Usage",
 CellChangeTimes->{{3.9555409642063713`*^9, 3.9555409992928944`*^9}, {
  3.9555410318173923`*^9, 3.955541048162859*^9}},
 CellID->271341312,ExpressionUUID->"1fddd8a3-9e14-2845-8d31-52db0b4a46e7"],

Cell[TextData[{
 "Ideally, ",
 Cell[BoxData[
  StyleBox["expr", "TI"]], "InlineFormula",ExpressionUUID->
  "3a69ffdc-bd70-3e47-828d-37964a6abb57"],
 " should contain the trigonometric functions Sin[x] and Cos[x] along with \
constants whose subscripts match ",
 Cell[BoxData[
  StyleBox["subscr1", "TI"]], "InlineFormula",ExpressionUUID->
  "528fe059-649a-e54b-8a28-486aa57af1d3"],
 " and ",
 Cell[BoxData[
  StyleBox["subscr2", "TI"]], "InlineFormula",ExpressionUUID->
  "b4ff1395-e8fe-7048-922f-2e3cba6260d0"],
 ". If none of these are present, applying this function will do nothing to ",
 Cell[BoxData[
  StyleBox["expr", "TI"]], "InlineFormula",ExpressionUUID->
  "a1f4b9fa-266b-1a4e-b2a8-e3a295d777e4"],
 "."
}], "Notes",
 CellChangeTimes->{3.9555410718252697`*^9},
 CellID->177110794,ExpressionUUID->"95a3abd6-7604-5843-aab8-0b1ff28ed563"]
}, Open  ]],

