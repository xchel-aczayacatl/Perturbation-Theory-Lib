Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FredholmAlternative", "[", 
  RowBox[{
   RowBox[{"u", "[", "x", "]"}], ",", 
   RowBox[{"f", "[", "x", "]"}], ",", "x", ",", "a", ",", "b"}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.9555432149148293`*^9, 3.955543223792366*^9}, {
  3.955543270866678*^9, 3.955543288256155*^9}},
 CellLabel->"In[1]:=",
 CellID->450727897,ExpressionUUID->"5dbc298c-bdd0-9e4a-b372-02ce5715066b"],

Cell[BoxData[
 RowBox[{
  SubsuperscriptBox["\[Integral]", "a", "b"], 
  RowBox[{
   RowBox[{
    RowBox[{"f", "[", "x", "]"}], " ", 
    RowBox[{"u", "[", "x", "]"}]}], 
   RowBox[{"\[DifferentialD]", "x"}]}]}]], "Output",
 CellChangeTimes->{3.955543297494644*^9},
 CellLabel->"Out[1]=",
 CellID->572117801,ExpressionUUID->"b4238fed-63c4-f94d-98c7-1077a134fa49"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FredholmAlternative", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Sin", "[", "x", "]"}], " ", 
     TemplateBox[{"1"},
      "C"]}], "+", 
    RowBox[{
     RowBox[{"Cos", "[", "x", "]"}], " ", 
     TemplateBox[{"2"},
      "C"]}]}], ",", 
   RowBox[{
    RowBox[{
     RowBox[{"Cosh", "[", "x", "]"}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        TemplateBox[{"1"},
         "C"], "[", "y", "]"}], "+", 
       RowBox[{
        RowBox[{
         TemplateBox[{"2"},
          "C"], "'"}], "[", "y", "]"}]}], ")"}]}], "+", 
    RowBox[{
     RowBox[{"Sinh", "[", "x", "]"}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", 
        RowBox[{
         TemplateBox[{"1"},
          "C"], "[", "y", "]"}]}], "-", 
       RowBox[{
        RowBox[{
         TemplateBox[{"2"},
          "C"], "'"}], "[", "y", "]"}]}], ")"}]}]}], ",", "x", ",", "0", ",", 
   RowBox[{"2", "\[Pi]"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9555433086531315`*^9, 3.9555433121781483`*^9}, {
  3.9555433630753307`*^9, 3.9555433713407764`*^9}, {3.955543416082903*^9, 
  3.9555435746057453`*^9}},
 CellLabel->"In[2]:=",
 CellID->666745642,ExpressionUUID->"2d220b7d-c565-ef4c-bf0f-05512d1171dd"],

Cell[BoxData[
 RowBox[{
  SuperscriptBox["\[ExponentialE]", 
   RowBox[{"-", "\[Pi]"}]], " ", 
  RowBox[{"Sinh", "[", "\[Pi]", "]"}], " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      FractionBox["1", "2"]}], " ", 
     RowBox[{"(", 
      RowBox[{
       TemplateBox[{"1"},
        "C"], "+", 
       RowBox[{"3", " ", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"2", " ", "\[Pi]"}]], " ", 
        RowBox[{"(", 
         RowBox[{
          TemplateBox[{"1"},
           "C"], "-", 
          TemplateBox[{"2"},
           "C"]}], ")"}]}], "+", 
       TemplateBox[{"2"},
        "C"]}], ")"}], " ", 
     RowBox[{
      TemplateBox[{"1"},
       "C"], "[", "y", "]"}]}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       TemplateBox[{"1"},
        "C"], "+", 
       TemplateBox[{"2"},
        "C"]}], ")"}], " ", 
     RowBox[{
      SuperscriptBox[
       TemplateBox[{"2"},
        "C"], "\[Prime]",
       MultilineFunction->None], "[", "y", "]"}]}]}], ")"}]}]], "Output",
 CellChangeTimes->{3.955543594263218*^9},
 CellLabel->"Out[2]=",
 CellID->159609730,ExpressionUUID->"ea77dd05-e262-1a44-b56d-97f0ac405d22"]
}, Open  ]]
}, Open  ]],

