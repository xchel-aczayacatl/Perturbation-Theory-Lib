Notebook[{

Cell[CellGroupData[{
Cell["MultiscaleExpansion", "ObjectName",
 CellID->221214956,ExpressionUUID->"04f4d6ba-c6a2-d342-ab99-fb7ed26abda3"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d1ab94b9-3794-e54f-ad86-08930505f237"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["MultiscaleExpansion",
    BaseStyle->"Link",
    ButtonData->"paclet:PerturbationTheory/ref/MultiscaleExpansion"], "[", 
   RowBox[{
    StyleBox["diffEqns", "TI"], ",", 
    StyleBox["depVars", "TI"], ",", 
    StyleBox["indepVar", "TI"], ",", 
    StyleBox["param", "TI"], ",", 
    StyleBox["expansionOrder", "TI"], ",", 
    StyleBox["numberScales", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "5c19a5a1-a6e4-f14c-8790-108b454c9429"],
 " \[LineSeparator]calculates the multiple scales asymptotic expansion of the \
differential equation(s) ",
 Cell[BoxData[
  StyleBox["diffEqns", "TI"]], "InlineFormula",ExpressionUUID->
  "3806572e-c51d-7c43-82da-e7c74250b514"],
 ", depending on the unknown function(s) ",
 Cell[BoxData[
  StyleBox["depVars", "TI"]], "InlineFormula",ExpressionUUID->
  "eee98990-fcad-7f40-800b-c20a8cdd7468"],
 " and the variable ",
 Cell[BoxData[
  StyleBox["indepVar", "TI"]], "InlineFormula",ExpressionUUID->
  "a8ed7c81-805f-6b42-a198-64728c5178be"],
 ", up to order ",
 Cell[BoxData[
  StyleBox["expansionOrder", "TI"]], "InlineFormula",ExpressionUUID->
  "c33c5190-4dde-1448-8001-2c19ff612b1a"],
 ", with the perturbation parameter ",
 Cell[BoxData[
  StyleBox["param", "TI"]], "InlineFormula",ExpressionUUID->
  "71b5aebd-6052-7842-944a-bc5c6bfaf9f4"],
 " and the quantity of scales defined by ",
 Cell[BoxData[
  StyleBox["numberScales", "TI"]], "InlineFormula",ExpressionUUID->
  "df0468ec-5646-c44d-9a97-ac24be22a2dc"],
 "."
}], "Usage",
 CellChangeTimes->{{3.95502509032288*^9, 3.95502538268536*^9}, {
  3.955025421682089*^9, 3.9550255882789497`*^9}},
 CellID->183032495,ExpressionUUID->"bbf69a80-3f16-c04f-9c64-1681ef58d4bc"],

Cell[TextData[{
 "The expressions ",
 Cell[BoxData[
  StyleBox["diffEqns", "TI"]], "InlineFormula",ExpressionUUID->
  "290b1e27-a8a0-e647-b5d3-847c47ff8ac7"],
 " and ",
 Cell[BoxData[
  StyleBox["depVars", "TI"]], "InlineFormula",ExpressionUUID->
  "029497be-36a8-5044-909b-1f096844f321"],
 " must be lists, the first being a list of differential equations and the \
second one being a list of the unknown functions."
}], "Notes",
 CellChangeTimes->{{3.955026130924532*^9, 3.955026131502241*^9}, {
  3.955026188316477*^9, 3.9550262817086926`*^9}, {3.9550266170064964`*^9, 
  3.9550266222937984`*^9}},
 CellID->126988052,ExpressionUUID->"a612a90e-411d-d545-8f3b-3c18a6a9e5e5"],

Cell[TextData[{
 "Additionally, ",
 Cell[BoxData[
  StyleBox["expansionOrder", "TI"]], "InlineFormula",ExpressionUUID->
  "70459a68-fa17-894c-bad9-bd918f5b5f13"],
 " and ",
 Cell[BoxData[
  StyleBox["numberScales", "TI"]], "InlineFormula",ExpressionUUID->
  "8bb42696-bc56-2e4d-bd45-21fb191f3e05"],
 " must be positive integer numbers."
}], "Notes",
 CellChangeTimes->{{3.9550262927106037`*^9, 3.9550263278593864`*^9}, {
  3.9550266289637623`*^9, 3.955026633023487*^9}},
 CellID->511752921,ExpressionUUID->"8864648b-d155-a64a-a60d-05b23b7b1c5f"]
}, Open  ]],

