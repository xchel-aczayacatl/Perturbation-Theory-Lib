Cell[BoxData[
 RowBox[{"MultiscaleExpansion", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"x", "''"}], "[", "t", "]"}], "+", 
      RowBox[{"b", " ", 
       RowBox[{
        RowBox[{"x", "'"}], "[", "t", "]"}]}], "+", 
      RowBox[{
       SuperscriptBox["\[Gamma]", "2"], 
       RowBox[{"x", "[", "t", "]"}]}]}], "==", "0"}], "}"}], ",", 
   RowBox[{"{", "x", "}"}], ",", "t", ",", "b", ",", "2", ",", "2"}], 
