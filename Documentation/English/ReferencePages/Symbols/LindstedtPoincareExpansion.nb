Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"3a9b9d14-aadc-5848-96fb-d049ee292104"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["LindstedtPoincareExpansion",
    BaseStyle->"Link",
    ButtonData->"paclet:PerturbationTheory/ref/LindstedtPoincareExpansion"], "[", 
   RowBox[{
    StyleBox["diffEqn", "TI"], ",", 
    StyleBox["depVar", "TI"], ",", 
    StyleBox["indepVar", "TI"], ",", 
    StyleBox["param", "TI"], ",", 
    StyleBox["expansionOrder", "TI"], 
    StyleBox[",", "TI"], 
    StyleBox["frec", "TI"], 
    StyleBox[",", "TI"], 
    StyleBox["nIndVar", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "4703c597-6e3a-db43-ad69-6d4efe758ded"],
 " \[LineSeparator]calculates the Lindstedt-Poincar\[EAcute] asymptotic \
expansion up to order ",
 Cell[BoxData[
  StyleBox["expansionOrder", "TI"]], "InlineFormula",ExpressionUUID->
  "174e2c31-c027-9d44-85dc-5306833e3934"],
 " with the new independent variable ",
 Cell[BoxData[
  StyleBox["nIndVar", "TI"]], "InlineFormula",ExpressionUUID->
  "7697d3ec-e0de-e445-a899-07dbb4321d62"],
 " of the differential equation ",
 Cell[BoxData[
  StyleBox["diffEqn", "TI"]], "InlineFormula",ExpressionUUID->
  "2b7b7e5b-cd49-b04a-b3b0-86e3326e7fcc"],
 " with perturbation parameter ",
 Cell[BoxData[
  StyleBox["param", "TI"]], "InlineFormula",ExpressionUUID->
  "705f9aa5-f70f-d84c-9481-9ed574be2a1e"],
 " and frequency ",
 Cell[BoxData[
  StyleBox["frec", "TI"]], "InlineFormula",ExpressionUUID->
  "3364ba8a-ec6b-af43-bbb0-4a0c6ca58507"],
 ", depending on the variable ",
 Cell[BoxData[
  StyleBox["indepVar", "TI"]], "InlineFormula",ExpressionUUID->
  "462afdbe-aa38-ac46-95c1-275db2d802b6"],
 " and the unknown function ",
 Cell[BoxData[
  StyleBox["depVar", "TI"]], "InlineFormula",ExpressionUUID->
  "da002e7d-b818-9446-8140-2bff72cbb6b5"],
 "."
}], "Usage",
 CellChangeTimes->{{3.955026871605463*^9, 3.955026919488943*^9}, {
