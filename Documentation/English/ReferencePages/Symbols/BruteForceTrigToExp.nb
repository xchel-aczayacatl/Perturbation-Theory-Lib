Cell["BruteForceTrigToExp", "ObjectName",
 CellID->444960675,ExpressionUUID->"190f5f18-6175-3843-a273-455400cd0cae"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"f9fe0bb0-6ca9-d24d-aa41-578bf3488a55"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["BruteForceTrigToExp",
    BaseStyle->"Link",
    ButtonData->"paclet:PerturbationTheory/ref/BruteForceTrigToExp"], "[", 
   StyleBox["expr", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "9a544b93-b2da-974f-b723-7cb7706dbab1"],
 " \[LineSeparator]transforms an expression ",
 Cell[BoxData[
  StyleBox["expr", "TI"]], "InlineFormula",ExpressionUUID->
  "8b4974fa-88c5-9649-8b5a-9de9ac94a69e"],
 " containing the trigonometric functions Sin[x] and Cos[x] into a new \
expression with complex exponentials."
}], "Usage",
 CellChangeTimes->{{3.9550295590398083`*^9, 3.9550295668606358`*^9}, {
  3.9550295987083664`*^9, 3.955029652512377*^9}, {3.9550297145739155`*^9, 
