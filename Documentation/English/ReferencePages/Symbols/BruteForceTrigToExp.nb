Cell[BoxData[
 RowBox[{
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"-", "\[ImaginaryI]"}], " ", "x"}]], " ", 
   TemplateBox[{"1"},
    "C"]}], "+", 
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"\[ImaginaryI]", " ", "x"}]], " ", 
   TemplateBox[{"2"},
    "C"]}]}]], "Output",
 CellChangeTimes->{3.9555417765739517`*^9},
 CellLabel->"Out[1]=",
