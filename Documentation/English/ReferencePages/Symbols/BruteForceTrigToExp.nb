Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"BruteForceTrigToExp", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Sin", "[", "x", "]"}], " ", 
    TemplateBox[{"1"},
     "C"]}], "+", 
   RowBox[{
    RowBox[{"Cos", "[", "x", "]"}], " ", 
    TemplateBox[{"2"},
     "C"]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.955541675607868*^9, 3.9555416787850456`*^9}, {
  3.955541748081402*^9, 3.9555417632743683`*^9}},
