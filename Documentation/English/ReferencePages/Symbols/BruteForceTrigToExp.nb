Cell[TextData[{
 "The expression ",
 Cell[BoxData[
  StyleBox["expr", "TI"]], "InlineFormula",ExpressionUUID->
  "1a2e190f-a137-1f4e-b2cb-ed0a5d0a362f"],
 " should contain Sin[x] and Cos[x], otherwise, the function will do nothing."
}], "Notes",
 CellChangeTimes->{{3.9550296618499985`*^9, 3.9550296962057495`*^9}, 
   3.955029732657984*^9},
