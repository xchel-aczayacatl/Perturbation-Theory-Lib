Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"NayfehTrigToExp", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Sin", "[", "x", "]"}], " ", 
     RowBox[{
      TemplateBox[{"1"},
       "C"], "[", "y", "]"}]}], "+", 
    RowBox[{
     RowBox[{"Cos", "[", "x", "]"}], " ", 
     RowBox[{
      TemplateBox[{"2"},
       "C"], "[", "y", "]"}]}]}], ",", "1", ",", "2", ",", "a", ",", "b"}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.955536763519827*^9, 3.9555367869214325`*^9}, 
   3.9555418843848667`*^9},
 CellLabel->"In[1]:=",
 CellID->82369787,ExpressionUUID->"e52f48c5-b49c-214f-a9b0-2b8682e52550"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"\[ImaginaryI]", " ", "x"}], "-", 
     RowBox[{"\[ImaginaryI]", " ", 
      RowBox[{"b", "[", "y", "]"}]}]}]], " ", 
   RowBox[{"a", "[", "y", "]"}]}], "+", 
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "\[ImaginaryI]"}], " ", "x"}], "+", 
     RowBox[{"\[ImaginaryI]", " ", 
      RowBox[{"b", "[", "y", "]"}]}]}]], " ", 
   RowBox[{"a", "[", "y", "]"}]}]}]], "Output",
 CellChangeTimes->{3.9555368133112354`*^9},
 CellLabel->"Out[1]=",
 CellID->743343434,ExpressionUUID->"820ab718-85aa-6e42-b505-ec3f876c7f6f"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"NayfehTrigToExp", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Sin", "[", 
      RowBox[{"\[Lambda]", " ", "x"}], "]"}], " ", 
     RowBox[{
      TemplateBox[{"a"},
       "C"], "[", 
      RowBox[{"\[Mu]", " ", "y"}], "]"}]}], "+", 
    RowBox[{
     RowBox[{"Cos", "[", 
      RowBox[{"\[Lambda]", " ", "x"}], "]"}], " ", 
     RowBox[{
      TemplateBox[{"b"},
       "C"], "[", 
      RowBox[{"\[Mu]", " ", "y"}], "]"}]}]}], ",", "a", ",", "b", ",", 
   "\[DoubleStruckM]", ",", "\[DoubleStruckN]"}], "]"}]], "Input",
 CellChangeTimes->{{3.955541912184862*^9, 3.9555420176955013`*^9}},
 CellLabel->"In[2]:=",
 CellID->68216656,ExpressionUUID->"3d04ad84-861c-b940-b9bc-9bdc90da4120"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"\[ImaginaryI]", " ", "x", " ", "\[Lambda]"}], "-", 
     RowBox[{"\[ImaginaryI]", " ", 
      RowBox[{"\[DoubleStruckN]", "[", 
       RowBox[{"y", " ", "\[Mu]"}], "]"}]}]}]], " ", 
   RowBox[{"\[DoubleStruckM]", "[", 
    RowBox[{"y", " ", "\[Mu]"}], "]"}]}], "+", 
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "\[ImaginaryI]"}], " ", "x", " ", "\[Lambda]"}], "+", 
     RowBox[{"\[ImaginaryI]", " ", 
      RowBox[{"\[DoubleStruckN]", "[", 
       RowBox[{"y", " ", "\[Mu]"}], "]"}]}]}]], " ", 
   RowBox[{"\[DoubleStruckM]", "[", 
    RowBox[{"y", " ", "\[Mu]"}], "]"}]}]}]], "Output",
 CellChangeTimes->{{3.955541998487999*^9, 3.955542024296833*^9}},
 CellLabel->"Out[2]=",
 CellID->104802280,ExpressionUUID->"1441e4f3-2ac8-0e4c-8baa-a9a7c4406750"]
}, Open  ]]
}, Open  ]],

