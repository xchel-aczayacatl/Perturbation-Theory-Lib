Notebook[{

Cell[CellGroupData[{
Cell["NayfehTrigToExp", "ObjectName",
 CellID->5542525,ExpressionUUID->"5d90ba0d-ddf3-1140-a91e-d2dc45313117"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"313ededa-213e-ac41-a421-82f2433b3837"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["NayfehTrigToExp",
    BaseStyle->"Link",
    ButtonData->"paclet:PerturbationTheory/ref/NayfehTrigToExp"], "[", 
   RowBox[{
    StyleBox["expr", "TI"], ",", 
    StyleBox["subscr1", "TI"], ",", 
    StyleBox["subscr2", "TI"], 
    StyleBox[",", "TI"], 
    StyleBox["var1", "TI"], 
    StyleBox[",", "TI"], 
    StyleBox["var2", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "780a8f4b-c9a2-e944-9b07-42fa57b9c7ec"],
 " \[LineSeparator]transforms all the constants with subscripts ",
 Cell[BoxData[
  StyleBox["subscr1", "TI"]], "InlineFormula",ExpressionUUID->
  "1f407a26-373a-2142-86d1-ec13cff616d9"],
 " and ",
 Cell[BoxData[
  StyleBox["subscr2", "TI"]], "InlineFormula",ExpressionUUID->
  "75e02c22-8467-294c-8ccf-2a2d6653b711"],
 " and all the ocurrences trigonometric functions Sin[x] and Cos[x] in the \
expression ",
 Cell[BoxData[
  StyleBox["expr", "TI"]], "InlineFormula",ExpressionUUID->
  "adbd2767-a215-754e-82fb-1e4c3847f588"],
 ", to complex exponentials in the form suggested by Nayfeh."
}], "Usage",
 CellChangeTimes->{{3.9550283164858875`*^9, 3.955028324553606*^9}, {
  3.955028537317709*^9, 3.955028731864086*^9}, {3.9550287641945095`*^9, 
  3.955028834859085*^9}, {3.9555367060865364`*^9, 3.955536717736744*^9}},
 CellID->746641427,ExpressionUUID->"90e3ced5-ae24-0948-bb6f-7a0022639e91"],

Cell[TextData[{
 "Ideally, ",
 Cell[BoxData[
  StyleBox["expr", "TI"]], "InlineFormula",ExpressionUUID->
  "3df81a7c-bb7a-d24b-98c9-696426e19eb9"],
 " should contain the trigonometric functions Sin[x] and Cos[x] along with \
constants whose subscripts match ",
 Cell[BoxData[
  StyleBox["subscr1", "TI"]], "InlineFormula",ExpressionUUID->
  "482006b8-2a1f-bd46-8fb2-521956985c55"],
 " and ",
 Cell[BoxData[
  StyleBox["subscr2", "TI"]], "InlineFormula",ExpressionUUID->
  "1de72d38-f853-004e-923e-39d986ab73fe"],
 ". If none of these are present, applying this function will do nothing to ",
 Cell[BoxData[
  StyleBox["expr", "TI"]], "InlineFormula",ExpressionUUID->
  "af83d746-3e91-3d4b-85ce-b655ccbf2985"],
 "."
}], "Notes",
 CellChangeTimes->{{3.9550288525040874`*^9, 3.9550290807169666`*^9}, {
  3.955029157855505*^9, 3.9550291591616707`*^9}},
 CellID->692610924,ExpressionUUID->"78470cb7-5327-c74e-bd0d-0a0bad0aa58c"]
}, Open  ]],

